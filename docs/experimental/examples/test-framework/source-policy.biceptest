//
// Source policies. These tests assert things about how the targets are *written*, so they need
// no parameter values at all: nothing here is deployed, and no `assert` statement in a target
// is involved.

var allowedResourceTypes = [
  'Microsoft.Storage/storageAccounts'
]

@description('Every module under modules/ is a leaf that creates exactly one storage account.')
test moduleSourcePolicy = {
  match: {
    root: 'modules'
    include: ['*.bicep']
    exclude: ['_*.bicep']
  }
  assertions: {
    onlyAllowedResourceTypes: {
      failOn: filter(target.resources, r => !contains(allowedResourceTypes, r.type))
      message: 'Modules under modules/ may only declare storage accounts.'
    }
    noExistingReferences: {
      failOn: filter(target.resources, r => r.existing)
      message: 'Modules must create the resources they own rather than adopt existing ones.'
    }
    isALeafModule: {
      passWhen: length(target.modules) == 0
      message: 'Modules under modules/ must not compose other modules.'
    }
    storageIsDeclaredOnce: {
      // Source facts name declarations symbolically: `symbolicName` is what the Bicep source calls
      // the declaration, not the ARM name it would be deployed under.
      passWhen: length(filter(target.resources, r => r.symbolicName == 'storageAccount')) == 1
      message: 'Each module must declare exactly one storage account, named storageAccount.'
    }
    reportsTheNameItChose: {
      // Declared outputs are part of a module's contract with its caller.
      passWhen: length(filter(target.outputs, o => o.name == 'storageAccountName' && o.type == 'string')) == 1
      message: 'Each module must output the storage account name it chose, as a string.'
    }
  }
}

@description('The entrypoint composes those modules and asks its caller for as little as possible.')
test compositionPolicy = {
  match: {
    include: ['app.bicep']
  }
  assertions: {
    entrypointOnlyComposes: {
      passWhen: length(target.resources) == 0 && length(target.modules) > 0
      message: 'app.bicep must compose modules rather than declare resources directly.'
    }
    composedTreeOnlyUsesAllowedTypes: {
      // `withModules` widens the query to the entrypoint plus every module it can reach.
      failOn: filter(target.withModules.resources, r => !contains(allowedResourceTypes, r.type))
      message: 'The composed deployment may only create storage accounts.'
    }
    deploysToAResourceGroup: {
      // The effective scope: app.bicep declares no targetScope, so it deploys to a resource group.
      passWhen: target.targetScope == 'resourceGroup'
      message: 'app.bicep must deploy to a resource group.'
    }
    callersOnlyChooseTheNamePrefix: {
      // `required` means no default and not nullable: the caller has to decide.
      passWhen: map(filter(target.parameters, p => p.required), p => p.name) == ['namePrefix']
      message: 'Only namePrefix may be required of a caller; everything else needs a default.'
    }
  }
}
