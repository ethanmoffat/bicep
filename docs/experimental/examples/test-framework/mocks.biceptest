param identityName string
param artifactStorageName string

var scope = '/subscriptions/00000000-0000-0000-0000-000000000001/resourceGroups/contoso-prod-rg'

// Every answer is invented for the test. Mocks never reach Azure, and a request the test did not
// configure is not answered by guessing.
mocks = {
  deployIdentity: {
    operation: 'reference'
    resourceId: '${scope}/providers/Microsoft.ManagedIdentity/userAssignedIdentities/${identityName}'
    apiVersion: '2023-01-31'
    response: {
      location: 'eastus'
      properties: {
        principalId: '11111111-1111-1111-1111-111111111111'
        clientId: '22222222-2222-2222-2222-222222222222'
      }
    }
  }
  artifactKeys: {
    operation: 'listKeys'
    resourceId: '${scope}/providers/Microsoft.Storage/storageAccounts/${artifactStorageName}'
    apiVersion: '2023-05-01'
    response: {
      keys: [
        {
          keyName: 'key1'
          value: 'not-a-real-key'
        }
      ]
    }
  }
}

test runtimeReads 'mocks.bicep' = {
  params: {
    identityName: identityName
    artifactStorageName: artifactStorageName
  }
  assertions: {
    identityIsResolved: {
      passWhen: target.evaluated.outputs.deployPrincipalId == '11111111-1111-1111-1111-111111111111'
      message: 'The deployment should read the principal ID of the identity it was given.'
    }
    clientIdIsResolved: {
      passWhen: target.evaluated.outputs.deployClientId == '22222222-2222-2222-2222-222222222222'
      message: 'The deployment should read the client ID of the identity it was given.'
    }
    usesPrimaryKey: {
      passWhen: target.evaluated.outputs.artifactKeyName == 'key1'
      message: 'The deployment should select the primary storage key.'
    }
    identityIsInTheExpectedRegion: {
      passWhen: target.evaluated.outputs.deployIdentityLocation == 'eastus'
      message: 'The same response should answer a read of the resource envelope.'
    }
  }
}
