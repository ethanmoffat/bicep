//
// A composition test: the values flow identity module -> caller -> access module, and the grant name
// is derived from all three. Only the principal ID is mocked; everything else is computed from source.

param workloadName string
param vaultName string

var scope = '/subscriptions/00000000-0000-0000-0000-000000000001/resourceGroups/contoso-prod-rg'

var vaultId = '${scope}/providers/Microsoft.KeyVault/vaults/${vaultName}'

var principalId = '33333333-3333-3333-3333-333333333333'

var secretsUserRoleId = '4633458b-17de-408a-b874-0445c86b69e6'

// Azure assigns a principal ID when it creates the identity, so the test states the one this case
// deploys with.
mocks = {
  workloadIdentity: {
    operation: 'reference'
    resourceId: '${scope}/providers/Microsoft.ManagedIdentity/userAssignedIdentities/${workloadName}-id'
    apiVersion: '2023-01-31'
    response: {
      properties: {
        principalId: principalId
      }
    }
  }
}

test vaultAccessIsGranted 'rbac.bicep' = {
  params: {
    workloadName: workloadName
    location: 'eastus'
    vaultName: vaultName
  }
  assertions: {
    principalFlowsThrough: {
      passWhen: target.evaluated.outputs.grantedPrincipalId == principalId
      message: 'The identity module\'s principal should reach the caller.'
    }
    grantIsDerivedFromWhatItGrants: {
      passWhen: target.evaluated.outputs.grantName == guid(vaultId, principalId, secretsUserRoleId)
      message: 'The role assignment name should be derived from the vault, the principal and the role.'
    }
    grantIsDeployed: {
      passWhen: length(filter(target.evaluated.withModules.resources, r => r.type == 'Microsoft.Authorization/roleAssignments')) == 1
      message: 'The composition should deploy exactly one role assignment.'
    }
  }
}
